---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import ServiceList from '../components/ServiceList.astro';
import RoomByRoom from '../components/RoomByRoom.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Process from '../components/Process.astro';
import RealGallery from '../components/RealGallery.astro';
import Reviews from '../components/Reviews.astro';
import AreaMap from '../components/AreaMap.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { business } from '../data/business';
import { serviceBySlug } from '../data/services';
import { generalFaqs } from '../data/faqs';
import { counties, citiesIn, cityUrl } from '../data/areas';
import { img } from '../lib/images';
import { faqSchema } from '../lib/schema';

const regular = serviceBySlug('regular-cleaning');
const homeFaqs = generalFaqs.slice(0, 8);
---
<Base
  title="House & Office Cleaning in Dallas, PA | Roamza Cleaning"
  description="Locally owned house and office cleaning in Dallas, PA and Luzerne, Lackawanna & Wyoming Counties. 5.0 on Google, 500+ families. Get a price in 15 seconds."
  image={img('team/roamza-cleaning-team.jpg')}
  schema={[faqSchema(homeFaqs)]}
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 glow-window pointer-events-none" aria-hidden="true"></div>
    <div class="container-x relative grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-10 items-center pt-8 pb-20 lg:pt-14 lg:pb-28">
      <div>
        <p class="eyebrow hero-rise">Luzerne · Lackawanna · Wyoming Counties</p>
        <h1 class="mt-5 hero-rise">
          <span class="block font-sans text-[clamp(1.05rem,.95rem+.5vw,1.35rem)] font-semibold tracking-normal text-royal mb-3">House &amp; office cleaning in Dallas, PA —</span>
          <span class="block text-[clamp(3rem,1.6rem+5.6vw,6.4rem)] leading-[.95]">Your space, our <em class="not-italic text-[#5f9400] relative whitespace-nowrap">cleaning<svg class="hero-underline" viewBox="0 0 300 18" aria-hidden="true" preserveAspectRatio="none"><path d="M3 13 C 80 3, 200 3, 297 11" /></svg></em> mission.</span>
        </h1>
        <p class="lead mt-7 max-w-xl hero-rise" style="animation-delay:.12s">
          A locally owned, background-checked team cleaning homes, vacation rentals and offices across northeastern Pennsylvania. Know your price in under 15 seconds — we respond within 15 minutes, 7 days a week.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 hero-rise" style="animation-delay:.2s">
          <a href="/get-a-quote/" class="btn btn-primary btn-lg" data-track="quote_start" data-magnetic>Get a Fast Quote <Icon name="arrow" size={18} /></a>
          <a href={business.phone.tel} class="btn btn-ghost btn-lg" data-track="call_click"><Icon name="phone" size={18} /> Call or text {business.phone.display}</a>
        </div>
        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-[.95rem] font-semibold text-navy hero-rise" style="animation-delay:.28s">
          <li class="flex items-center gap-2"><span class="flex text-lime" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} />)}</span>Trusted by 500+ local families</li>
          <li class="flex items-center gap-2"><Icon name="google" size={18} class="text-royal" /> 5.0 on Google</li>
          <li class="flex items-center gap-2"><Icon name="shield" size={18} class="text-royal" /> Licensed, bonded &amp; insured</li>
        </ul>
      </div>

      <!-- layered collage -->
      <div class="relative min-h-[26rem] sm:min-h-[34rem] lg:min-h-[40rem]">
        <div class="absolute right-0 top-0 w-[78%] hero-zoom" data-parallax="0.04">
          <div class="roof-mask overflow-hidden rounded-b-[2rem] aspect-[4/4.6] shadow-[var(--shadow-lift)]" data-tilt="4">
            <Image src={img('team/roamza-cleaning-team.jpg')} alt="Roamza Cleaning Services owner Miriam and her cleaning team with their equipment" widths={[420, 640, 840, 1024]} sizes="(min-width: 1024px) 30rem, 78vw" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
          </div>
        </div>
        <div class="absolute left-0 bottom-6 w-[46%] hidden sm:block" data-parallax="-0.08">
          <figure class="rounded-[1.5rem] overflow-hidden border-[6px] border-white shadow-[var(--shadow-lift)] aspect-[3/4] rotate-[-3deg]">
            <Image src={img('real/open-kitchen-quartz-counter.jpg')} alt="Spotless kitchen counter after a real Roamza cleaning" widths={[280, 420, 560]} sizes="14rem" class="w-full h-full object-cover" loading="eager" />
          </figure>
          <p class="mt-2 text-xs font-semibold text-muted pl-2">Real Roamza job</p>
        </div>
        <a href="/get-a-quote/" class="quote-chip card absolute left-[6%] sm:left-[30%] top-[62%] sm:top-auto sm:bottom-0 flex items-center gap-4 px-5 py-4 max-w-[19rem]" data-track="quote_start" data-parallax="-0.03">
          <span class="grid place-items-center w-12 h-12 rounded-full bg-lime text-navy flex-none"><Icon name="bolt" size={22} /></span>
          <span>
            <span class="block text-xs font-semibold tracking-[.12em] uppercase text-royal">Fast Quote</span>
            <span class="block font-semibold text-navy leading-snug">See your price in under 15 seconds</span>
          </span>
        </a>
        <div class="absolute right-3 -top-3 sm:right-[-.5rem] sm:top-10 w-24 sm:w-28 rotate-[8deg]" data-parallax="0.1">
          <Image src={img('brand/licensed-bonded-insured-seal.png')} alt="Licensed, bonded and insured seal" width={140} height={121} class="w-full h-auto drop-shadow-xl" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROOF NUMBERS ============ -->
  <section aria-label="Roamza by the numbers" class="container-x -mt-6 lg:-mt-10 relative">
    <Stats />
  </section>

  <!-- ============ THE PROBLEM ============ -->
  <section class="py-20 lg:py-32" aria-labelledby="problem-heading">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20 items-center">
      <div class="relative order-2 lg:order-1" data-reveal="scale">
        <div class="rounded-[1.75rem] overflow-hidden aspect-[4/3.3] shadow-[var(--shadow-soft)]" data-parallax="0.04">
          <Image src={img('lifestyle/family-relaxing-clean-home.jpg')} alt="Family relaxing together on the living room floor of a clean home" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 36rem, 100vw" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="eyebrow" data-reveal>Why families call us</p>
        <h2 id="problem-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">Cleaning shouldn’t be one more thing you carry every week.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">Between work, family and schedules, cleaning becomes a mental weight. You don’t just need cleaning — you need consistency, reliability and the peace of mind that your home will be clean without thinking about it. <strong class="text-navy">That’s exactly what we do.</strong></p>
        <div class="mt-9 grid sm:grid-cols-2 gap-4">
          <div class="rounded-2xl bg-linen p-6" data-reveal style="--d:160">
            <p class="text-sm font-semibold tracking-[.14em] uppercase text-muted">Before Roamza</p>
            <ul class="mt-3 grid gap-2 text-muted">
              <li>Weekends spent cleaning</li><li>Stress before guests arrive</li><li>Cleaning that never ends</li><li>Never feeling “caught up”</li>
            </ul>
          </div>
          <div class="rounded-2xl bg-navy p-6 on-dark" data-reveal style="--d:220">
            <p class="text-sm font-semibold tracking-[.14em] uppercase text-lime">With Roamza</p>
            <ul class="check-list mt-3 grid gap-2 text-white">
              <li>Walk into a fresh, clean home</li><li>More time for what matters</li><li>Zero cleaning stress</li><li>Professional results every visit</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="pb-20 lg:pb-28" aria-labelledby="services-heading">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end mb-10">
        <div class="max-w-3xl">
          <p class="eyebrow" data-reveal>Cleaning services</p>
          <h2 id="services-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">Cleaning services built around real life.</h2>
          <p class="lead mt-4" data-reveal style="--d:120">Six services, one standard. Recurring visits weekly, bi-weekly, every 3 weeks or monthly — or a one-time deep, move or post-construction clean.</p>
        </div>
        <a href="/cleaning-services/" class="btn btn-ghost" data-reveal>Compare all services <Icon name="arrow" size={18} /></a>
      </div>
      <ServiceList />
    </div>
  </section>

  <!-- ============ ROOM BY ROOM ============ -->
  <RoomByRoom
    rooms={regular.rooms}
    heading="What’s included in every regular cleaning"
    intro="A clear checklist for every room — so you always know what “clean” means at Roamza. Signature Deep Cleaning adds baseboards, doors, blinds, fans and behind appliances."
    note="Need more? Add inside the fridge or oven, interior windows, detailed baseboards, organization or linen changes. Add-ons must be requested in advance; additional charges may apply."
  />

  <!-- ============ BEFORE / AFTER ============ -->
  <section class="py-20 lg:py-28" aria-labelledby="ba-heading">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.7fr] lg:gap-16 items-center">
      <div>
        <p class="eyebrow" data-reveal>See the difference</p>
        <h2 id="ba-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">Imagine walking into clean — every time.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">Drag the handle to compare the same room before and after a Roamza visit.</p>
        <a href="/deep-cleaning/" class="link-u inline-block mt-6" data-reveal style="--d:160">Explore Signature Deep Cleaning →</a>
      </div>
      <div data-reveal="scale" style="--d:100"><BeforeAfter /></div>
    </div>
  </section>

  <!-- ============ WHY ROAMZA ============ -->
  <section class="py-20 lg:py-28 bg-cloud relative overflow-hidden" aria-labelledby="why-heading">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20 items-center">
      <div class="relative">
        <div class="grid grid-cols-[1.25fr_1fr] gap-4 items-end">
          <div class="roof-mask overflow-hidden rounded-b-[1.5rem] aspect-[3/4.2] shadow-[var(--shadow-soft)]" data-reveal style="--d:0">
            <Image src={img('team/miriam-rodriguez-founder.jpg')} alt="Miriam Rodriguez, owner and founder of Roamza Cleaning Services" widths={[360, 540, 720]} sizes="(min-width: 1024px) 18rem, 55vw" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="grid gap-4">
            <div class="rounded-[1.25rem] overflow-hidden aspect-square shadow-[var(--shadow-soft)]" data-reveal style="--d:120">
              <Image src={img('team/roamza-team-uniforms.jpg')} alt="Roamza team members in uniform" widths={[300, 480]} sizes="14rem" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="card p-4 flex items-center gap-3" data-reveal style="--d:200">
              <Image src={img('brand/cleaning-for-a-reason-premium-partner.png')} alt="Cleaning for a Reason Premium Partner badge" width={64} height={64} class="w-14 h-14" />
              <p class="text-sm font-semibold text-navy leading-snug">Premium Partner of Cleaning for a Reason</p>
            </div>
          </div>
        </div>
      </div>
      <div>
        <p class="eyebrow" data-reveal>A local company you can actually trust</p>
        <h2 id="why-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">Not a franchise. Not a call center. Your neighbors.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">Roamza is locally owned and led by founder Miriam Rodriguez, with {business.yearsExperience} years of cleaning experience in Dallas, PA. We’re a real local team that cares about every home we clean — our reputation is built one home at a time.</p>
        <ul class="mt-9 grid sm:grid-cols-2 gap-x-8 gap-y-7">
          {[
            { i: 'clock', t: 'Real reliability', d: 'We show up. On time. Every time.' },
            { i: 'user', t: 'Professional team', d: 'Trained, background-checked cleaners — not random workers.' },
            { i: 'home', t: 'Respect for your space', d: 'We clean like we’re cleaning our own home.' },
            { i: 'sms', t: 'Easy communication', d: 'Call. Text. Book. Done.' },
          ].map((v, idx) => (
            <li class="flex gap-4" data-reveal style={`--d:${idx * 80}`}>
              <span class="grid place-items-center w-11 h-11 rounded-xl bg-white text-royal shadow-[var(--shadow-soft)] flex-none"><Icon name={v.i} size={22} /></span>
              <span><span class="block font-semibold text-navy text-lg">{v.t}</span><span class="block text-muted mt-1">{v.d}</span></span>
            </li>
          ))}
        </ul>
        <div class="mt-9 flex flex-wrap gap-2" data-reveal>
          {business.badges.map((b) => <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy ring-1 ring-line"><Icon name="check" size={16} class="text-lime-600" />{b}</span>)}
        </div>
        <a href="/about/" class="link-u inline-block mt-8" data-reveal>Meet Miriam and the team →</a>
      </div>
    </div>
  </section>

  <Process />

  <RealGallery />

  <Reviews />

  <!-- ============ SERVICE AREAS ============ -->
  <section class="py-20 lg:py-28" aria-labelledby="areas-heading">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16 items-start">
      <div>
        <p class="eyebrow" data-reveal>Service areas</p>
        <h2 id="areas-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">Proudly serving three counties from the Back Mountain.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">From our base in Dallas, PA we clean homes, rentals and offices across Luzerne, Lackawanna and Wyoming Counties. Hover a town on the map — or pick it from the list.</p>
        <div class="mt-9 grid gap-8">
          {Object.entries(counties).map(([slug, c]) => (
            <div data-reveal>
              <h3 class="text-xl"><a href={`/service-areas/${slug}/`} class="hover:text-royal">{c.name}</a></h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {citiesIn(slug as keyof typeof counties).map((city) => city.status === 'published'
                  ? <li><a href={cityUrl(city)} class="inline-flex rounded-full bg-navy text-white px-3.5 py-1.5 text-sm font-semibold hover:bg-royal transition-colors">{city.name}</a></li>
                  : <li class="inline-flex rounded-full bg-cloud px-3.5 py-1.5 text-sm text-ink">{city.name}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <a href="/service-areas/" class="btn btn-ghost mt-10" data-reveal>All service areas <Icon name="arrow" size={18} /></a>
      </div>
      <div data-reveal="scale"><AreaMap /></div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="py-20 lg:py-28 bg-linen" aria-label="Frequently asked questions">
    <div class="container-x">
      <Faq faqs={homeFaqs} heading="Questions, answered" intro="Straight answers about pricing, scheduling, coverage and what to expect from Roamza." />
      <p class="mt-10"><a href="/faq/" class="link-u">See all FAQs →</a></p>
    </div>
  </section>

  <CtaFinal />
</Base>

<style>
  .hero-underline { position: absolute; left: 0; right: 0; bottom: -.12em; width: 100%; height: .22em; overflow: visible; }
  .hero-underline path { fill: none; stroke: var(--color-lime); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 320; stroke-dashoffset: 320; animation: draw-line 1.2s .6s var(--ease-out-soft) forwards; }
  @keyframes draw-line { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .hero-underline path { stroke-dashoffset: 0; animation: none; } }
  .quote-chip { transition: transform .5s var(--ease-out-soft), box-shadow .5s; }
  .quote-chip:hover { box-shadow: var(--shadow-lift); }
</style>
