---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import RoomByRoom from '../components/RoomByRoom.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Process from '../components/Process.astro';
import RealGallery from '../components/RealGallery.astro';
import Reviews from '../components/Reviews.astro';
import AreaMap from '../components/AreaMap.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Backdrop from '../components/Backdrop.astro';
import ChapterRail from '../components/ChapterRail.astro';
import HeroQuote from '../components/HeroQuote.astro';
import ServiceTiles from '../components/ServiceTiles.astro';
import FixedBand from '../components/FixedBand.astro';
import AnimatedIcon from '../components/AnimatedIcon.astro';
import GoogleG from '../components/GoogleG.astro';
import { business } from '../data/business';
import { services, serviceBySlug } from '../data/services';
import { generalFaqs } from '../data/faqs';
import { counties, citiesIn, cityUrl } from '../data/areas';
import { img } from '../lib/images';
import { faqSchema } from '../lib/schema';

const regular = serviceBySlug('regular-cleaning');
const hv = business.heroVideo;
const homeFaqs = generalFaqs.slice(0, 8);
const chapters = [
  { id: 'welcome', label: 'Welcome' },
  { id: 'why', label: 'Why families call' },
  { id: 'services', label: 'Services' },
  { id: 'checklist', label: 'Room by room' },
  { id: 'results', label: 'Before & after' },
  { id: 'neighbors', label: 'Your neighbors' },
  { id: 'how', label: 'How it works' },
  { id: 'work', label: 'Real work' },
  { id: 'reviews', label: 'Reviews' },
  { id: 'areas', label: 'Service areas' },
  { id: 'faq', label: 'Questions' },
  { id: 'book', label: 'Book' },
];
const band = services.map((s) => s.name.replace(' & Vacation Rental Turnover', '').replace('Office & Commercial', 'Office').replace('Signature ', ''));
---
<Base
  title="House & Office Cleaning in Dallas, PA | Roamza Cleaning"
  description="Locally owned house and office cleaning in Dallas, PA and Luzerne, Lackawanna & Wyoming Counties. 5.0 on Google, 500+ families. Get a price in 15 seconds."
  image={img('team/roamza-cleaning-team.jpg')}
  schema={[faqSchema(homeFaqs)]}
>
  <ChapterRail chapters={chapters} />

  <!-- ============ HERO · Welcome (video background + live quote) ============ -->
  <section id="welcome" class="hero-v on-dark relative overflow-hidden">
    {hv && (
      <div class="hv-media" aria-hidden="true">
        <video class="hv-video" muted loop playsinline preload="none" poster={hv.poster} data-hero-video>
          <source data-src={hv.mp4Mobile} type="video/mp4" media="(max-width: 767.98px)" />
          <source data-src={hv.webm} type="video/webm" />
          <source data-src={hv.mp4} type="video/mp4" />
        </video>
      </div>
    )}
    <div class="hv-shade" aria-hidden="true"></div>
    <Backdrop variant={['grain']} tone="dark" />
    <div class="container-x relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_31rem] lg:gap-14 items-center pt-8 pb-10 lg:pt-8 lg:pb-10">
      <div class="hv-copy">
        <p class="eyebrow hero-rise">Luzerne · Lackawanna · Wyoming Counties</p>
        <h1 class="mt-4 hero-rise">
          <span class="block font-sans text-[clamp(1rem,.95rem+.35vw,1.2rem)] font-semibold tracking-normal text-lime mb-2">House &amp; office cleaning in Dallas, PA —</span>
          <span class="block text-[clamp(2.5rem,1.5rem+3.3vw,4.5rem)] leading-[1.02]">Your space, our <mark class="hero-mark">cleaning</mark> mission.</span>
        </h1>
        <p class="mt-5 max-w-lg text-[1.08rem] leading-relaxed hero-rise" style="animation-delay:.12s">
          Locally owned, background-checked cleaning for homes, rentals and offices. See your price in 15 seconds.
        </p>
        <div class="mt-7 flex flex-wrap gap-3 hero-rise" style="animation-delay:.2s">
          <a href="#hero-quote" class="btn btn-primary btn-lg" data-track="quote_start">Get my live quote <Icon name="arrow" size={18} /></a>
          <a href={business.phone.tel} class="btn btn-ghost btn-lg" data-track="call_click"><Icon name="phone" size={18} /> Call {business.phone.display}</a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-[.92rem] font-semibold text-white hero-rise" style="animation-delay:.28s">
          <li class="flex items-center gap-2"><span class="flex text-lime" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={15} />)}</span>500+ local families</li>
          <li class="flex items-center gap-2"><GoogleG size={17} /> 5.0 on Google</li>
          <li class="flex items-center gap-2"><Icon name="shield" size={17} class="text-lime" /> Licensed, bonded &amp; insured</li>
        </ul>
        {hv && <button type="button" class="hv-toggle" aria-pressed="false" data-hero-video-toggle><span data-label>Pause video</span></button>}
      </div>

      <!-- the live quote widget, on its own (like the original site) -->
      <HeroQuote />
    </div>
  </section>

  <!-- ============ PROOF RIBBON (dark) ============ -->
  <section aria-label="Roamza by the numbers" class="container-x relative z-[2] mt-6 lg:mt-8">
    <div class="relative overflow-hidden rounded-[1.75rem] bg-navy on-dark px-4 md:px-8 shadow-[0_30px_60px_-30px_rgb(14_10_79/.6)]">
      <Backdrop variant={['roofs']} tone="dark" />
      <div class="relative"><Stats dark /></div>
    </div>
  </section>

  <!-- ============ 01 · WHY FAMILIES CALL ============ -->
  <section id="why" class="relative py-24 lg:py-36 overflow-hidden" aria-labelledby="problem-heading">
    <Backdrop variant={['cloud', 'grain']} cloudPos="left" />
    <div class="container-x relative">
      <p class="chapter" data-reveal><b>01</b><i></i>Why families call us</p>
      <h2 id="problem-heading" class="sr-only">Cleaning shouldn’t be one more thing you carry every week</h2>
      <p class="mt-8 font-display text-navy text-[clamp(1.7rem,1.2rem+2vw,3rem)] leading-[1.15] tracking-[-.02em] max-w-[22ch] lg:max-w-[24ch]" data-scrub>
        Between work, family and schedules, cleaning becomes one more weight you carry. You don’t just need cleaning — you need <mark class="scrub-mark">consistency</mark>, <mark class="scrub-mark">reliability</mark> and a home that’s clean <mark class="scrub-mark">without thinking about it.</mark>
      </p>

      <div class="mt-16 lg:mt-24 grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-20 items-center">
        <div class="photo-obj frame-navy rounded-[1.75rem]" data-reveal="scale" data-tilt="4">
          <div class="photo-inner aspect-[4/3.2]">
            <Image src={img('lifestyle/family-relaxing-clean-home.jpg')} alt="Family relaxing together on the living room floor of a clean home" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 36rem, 100vw" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
        <div class="grid gap-4">
          <div class="ba-card rounded-[1.25rem] bg-linen p-6 md:p-7" data-reveal style="--d:80">
            <p class="text-sm font-semibold tracking-[.14em] uppercase text-muted">Before Roamza</p>
            <ul class="mt-4 grid gap-2.5 text-muted">
              <li class="strike">Weekends spent cleaning</li><li class="strike">Stress before guests arrive</li><li class="strike">Cleaning that never ends</li><li class="strike">Never feeling “caught up”</li>
            </ul>
          </div>
          <div class="ba-card relative overflow-hidden rounded-[1.25rem] bg-navy p-6 md:p-7 on-dark md:ml-10" data-reveal style="--d:200">
            <Backdrop variant={['glow']} tone="dark" />
            <p class="relative text-sm font-semibold tracking-[.14em] uppercase text-lime">With Roamza</p>
            <ul class="relative check-list mt-4 grid gap-2.5 text-white text-[1.05rem]">
              <li>Walk into a fresh, clean home</li><li>More time for what matters</li><li>Zero cleaning stress</li><li>Professional results every visit</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FixedBand
    image="proof/living-room-after.jpg"
    eyebrow="Imagine it"
    statement="Walk into clean — every single time."
    sub="Same standard, same checklist, every visit. That’s the Roamza promise to 500+ local families."
  >
    <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:220">
      <a href="#hero-quote" class="btn btn-primary btn-lg" data-track="quote_start">Get my live quote <Icon name="arrow" size={18} /></a>
    </div>
  </FixedBand>

  <!-- ============ 02 · SERVICES ============ -->
  <section id="services" class="relative py-24 lg:py-32 overflow-hidden" aria-labelledby="services-heading">
    <Backdrop variant={['roofs', 'grain']} />
    <span class="big-num" aria-hidden="true" data-parallax="0.12">06</span>
    <div class="container-x relative">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end mb-12">
        <div class="max-w-3xl">
          <p class="chapter" data-reveal><b>02</b><i></i>Cleaning services</p>
          <h2 id="services-heading" class="mt-5 text-[clamp(2.1rem,1.4rem+2.4vw,3.5rem)]" data-words>Cleaning services built around real life.</h2>
          <p class="lead mt-5" data-reveal style="--d:120">Six services, one standard. Recurring visits weekly, bi-weekly, every 3 weeks or monthly — or a one-time deep, move or post-construction clean.</p>
        </div>
        <a href="/cleaning-services/" class="link-u" data-reveal>Compare all services →</a>
      </div>
      <ServiceTiles />
    </div>
  </section>

  <!-- ============ 03 · ROOM BY ROOM (dark scene) ============ -->
  <RoomByRoom
    id="checklist"
    tone="dark"
    chapter="03"
    rooms={regular.rooms}
    heading="What’s included in every regular cleaning"
    intro="A clear checklist for every room — so you always know what “clean” means at Roamza. Signature Deep Cleaning adds baseboards, doors, blinds, fans and behind appliances."
    note="Need more? Add inside the fridge or oven, interior windows, detailed baseboards, organization or linen changes. Add-ons must be requested in advance; additional charges may apply."
  />

  <!-- ============ 04 · BEFORE / AFTER ============ -->
  <section id="results" class="relative py-24 lg:py-32 overflow-hidden" aria-labelledby="ba-heading">
    <Backdrop variant={['glow', 'roofs', 'grain']} />
    <div class="container-x relative grid gap-12 lg:grid-cols-[1fr_1.7fr] lg:gap-16 items-center">
      <div>
        <p class="chapter" data-reveal><b>04</b><i></i>See the difference</p>
        <h2 id="ba-heading" class="mt-5 text-[clamp(2.1rem,1.4rem+2.4vw,3.5rem)]" data-words>See the difference in one swipe.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">Drag the handle to compare the same room before and after a Roamza visit.</p>
        <a href="/deep-cleaning/" class="link-u inline-block mt-7" data-reveal style="--d:160">Explore Signature Deep Cleaning →</a>
      </div>
      <div class="ba-frame" data-reveal="scale" style="--d:100"><BeforeAfter /></div>
    </div>
  </section>

  <!-- ============ 05 · YOUR NEIGHBORS ============ -->
  <section id="neighbors" class="relative py-24 lg:py-36 overflow-hidden neighbors" aria-labelledby="why-heading">
    <Backdrop variant={['cloud', 'roofs', 'grain']} cloudPos="right" />
    <div class="container-x relative">
      <p class="chapter" data-reveal><b>05</b><i></i>A local company you can actually trust</p>
      <h2 id="why-heading" class="mt-6 font-display text-[clamp(2.3rem,1.4rem+3vw,4.2rem)] leading-[1.02] max-w-[18ch]" data-words>Not a franchise. Not a call center. Your neighbors.</h2>

      <div class="mt-16 grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20 items-start">
        <div class="relative lg:sticky lg:top-28">
          <div class="grid grid-cols-[1.25fr_1fr] gap-5 items-end">
            <div class="photo-obj roof-obj rounded-b-[1.5rem]" data-tilt="4">
              <div class="photo-inner roof-mask aspect-[3/4.2]" data-roofwipe>
                <Image src={img('team/miriam-rodriguez-founder.jpg')} alt="Miriam Rodriguez, owner and founder of Roamza Cleaning Services" widths={[360, 540, 720]} sizes="(min-width: 1024px) 18rem, 55vw" class="w-full h-full object-cover" loading="lazy" />
              </div>
            </div>
            <div class="grid gap-5" data-parallax="-0.06">
              <div class="photo-obj frame-navy rounded-[1.25rem]" data-reveal style="--d:120" data-tilt="5">
                <div class="photo-inner aspect-square">
                  <Image src={img('team/roamza-team-uniforms.jpg')} alt="Roamza team members in uniform" widths={[300, 480]} sizes="14rem" class="w-full h-full object-cover" loading="lazy" />
                </div>
              </div>
              <div class="card p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3" data-reveal style="--d:200">
                <Image src={img('brand/cleaning-for-a-reason-premium-partner.png')} alt="Cleaning for a Reason Premium Partner badge" width={64} height={64} class="w-14 h-14" />
                <p class="text-sm font-semibold text-navy leading-snug">Premium Partner of Cleaning for a Reason</p>
              </div>
            </div>
          </div>
          <p class="mt-5 text-sm text-muted">Miriam Rodriguez, Owner &amp; Founder — {business.yearsExperience} years of cleaning experience</p>
        </div>
        <div>
          <p class="lead" data-reveal>Roamza is locally owned and led by founder Miriam Rodriguez in Dallas, PA. We’re a real local team that cares about every home we clean — <strong class="text-navy">our reputation is built one home at a time.</strong></p>
          <ul class="mt-10 grid sm:grid-cols-2 gap-4">
            {[
              { i: 'clock', t: 'Real reliability', d: 'We show up. On time. Every time.' },
              { i: 'user', t: 'Professional team', d: 'Trained, background-checked cleaners — not random workers.' },
              { i: 'home', t: 'Respect for your space', d: 'We clean like we’re cleaning our own home.' },
              { i: 'chat', t: 'Easy communication', d: 'Call. Text. Book. Done.' },
            ].map((v, idx) => (
              <li class="value-card ai-host" data-reveal style={`--d:${idx * 80}`} data-spotlight>
                <span class="value-ico"><AnimatedIcon name={v.i} size={26} /></span>
                <span class="block font-semibold text-navy text-lg mt-4">{v.t}</span>
                <span class="block text-muted mt-1">{v.d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-2" data-reveal>
            {business.badges.map((b) => <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-navy ring-1 ring-line"><Icon name="check" size={16} class="text-lime-600" />{b}</span>)}
          </div>
          <a href="/about/" class="link-u inline-block mt-8" data-reveal>Meet Miriam and the team →</a>
        </div>
      </div>
    </div>
  </section>

  <div id="how"><Process heading="Getting started is simple" chapter="06" /></div>

  <div id="work" class="bg-linen relative"><Backdrop variant={['grain']} /><RealGallery chapter="07" /></div>

  <div id="reviews"><Reviews chapter="08" /></div>

  <!-- ============ 09 · SERVICE AREAS ============ -->
  <section id="areas" class="relative py-24 lg:py-32 overflow-hidden" aria-labelledby="areas-heading">
    <Backdrop variant={['roofs', 'glow', 'grain']} />
    <div class="container-x relative grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-16 items-start">
      <div>
        <p class="chapter" data-reveal><b>09</b><i></i>Service areas</p>
        <h2 id="areas-heading" class="mt-5 text-[clamp(2.1rem,1.4rem+2.4vw,3.5rem)]" data-words>Proudly serving three counties from the Back Mountain.</h2>
        <p class="lead mt-5" data-reveal style="--d:120">From our base in Dallas, PA we clean homes, rentals and offices across Luzerne, Lackawanna and Wyoming Counties. Hover a town on the map — or pick it from the list.</p>
        <div class="mt-9 grid gap-8">
          {Object.entries(counties).map(([slug, c]) => (
            <div data-reveal data-more class="towns">
              <h3 class="text-xl"><a href={`/service-areas/${slug}/`} class="hover:text-royal">{c.name}</a></h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {citiesIn(slug as keyof typeof counties).map((city) => city.status === 'published'
                  ? <li><a href={cityUrl(city)} class="town-pill is-pub"><Icon name="pin" size={14} />{city.name}</a></li>
                  : <li class="town-pill more-item">{city.name}</li>)}
              </ul>
              {citiesIn(slug as keyof typeof counties).filter((x) => x.status === 'draft').length > 0 && (
                <button type="button" class="more-btn lg:hidden" aria-expanded="false" data-more-btn>+ {citiesIn(slug as keyof typeof counties).filter((x) => x.status === 'draft').length} more towns</button>
              )}
            </div>
          ))}
        </div>
        <a href="/service-areas/" class="link-u inline-block mt-8" data-reveal>All service areas →</a>
      </div>
      <div data-reveal="scale" class="map-frame lg:sticky lg:top-28"><AreaMap /></div>
    </div>
  </section>

  <!-- ============ 10 · FAQ ============ -->
  <section id="faq" class="relative py-24 lg:py-32 bg-linen overflow-hidden" aria-label="Frequently asked questions">
    <Backdrop variant={['grain']} />
    <div class="container-x relative">
      <p class="chapter mb-8" data-reveal><b>10</b><i></i>Questions, answered</p>
      <Faq faqs={homeFaqs} heading="Straight answers before you book" intro="Pricing, scheduling, coverage and what to expect from Roamza." />
      <p class="mt-10"><a href="/faq/" class="link-u">See all FAQs →</a></p>
    </div>
  </section>

  <CtaFinal id="book" />
</Base>

<style>
  .hero-mark { color: var(--color-lime); background: linear-gradient(transparent 64%, rgb(119 185 0 / .32) 64%, rgb(119 185 0 / .32) 94%, transparent 94%) no-repeat 0 0 / 100% 100%; padding-inline: .06em; border-radius: .08em; }
  .hero-v { background: var(--color-navy); color: #fff; }
  .hv-media { position: absolute; inset: 0; }
  .hv-video { width: 100%; height: 100%; object-fit: cover; }
  .hv-shade { position: absolute; inset: 0; background:
      linear-gradient(90deg, rgb(14 10 79 / .94) 0%, rgb(14 10 79 / .82) 38%, rgb(14 10 79 / .45) 70%, rgb(14 10 79 / .35) 100%),
      linear-gradient(180deg, rgb(14 10 79 / .2) 0%, transparent 30%, rgb(14 10 79 / .5) 100%); }
  @media (max-width: 1023.98px) { .hv-shade { background: linear-gradient(180deg, rgb(14 10 79 / .62) 0%, rgb(14 10 79 / .84) 50%, rgb(14 10 79 / .95) 100%); } }
  .hv-toggle { margin-top: 1.25rem; min-height: 2.75rem; font-size: .82rem; font-weight: 600; color: rgb(255 255 255 / .75); text-decoration: underline; text-underline-offset: 4px; }
  .hv-toggle:hover { color: #fff; }
  :global(html:not(.js)) .hv-toggle { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-mark { background-size: 0% 100%; animation: mark-in .9s .55s var(--ease-out-soft) forwards; }
  }
  @keyframes mark-in { to { background-size: 100% 100%; } }
  .quote-chip { transition: transform .5s var(--ease-out-soft), box-shadow .5s; z-index: 3; }
  .quote-chip:hover { box-shadow: var(--shadow-lift); }
  .qc-pulse { position: relative; }
  .qc-pulse::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 0 rgb(119 185 0 / .55); animation: qc 2.4s ease-out infinite; }
  @keyframes qc { 70%, 100% { box-shadow: 0 0 0 14px rgb(119 185 0 / 0); } }

  .scroll-cue { position: absolute; left: 50%; bottom: 7.5rem; translate: -50% 0; width: 1.6rem; height: 2.6rem; border-radius: 999px; box-shadow: inset 0 0 0 1.5px rgb(21 14 117 / .35); justify-content: center; }
  .scroll-cue span { width: 3px; height: .55rem; margin-top: .45rem; border-radius: 3px; background: var(--color-navy); animation: cue 1.8s var(--ease-out-soft) infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 80% { transform: translateY(.8rem); opacity: 0; } 100% { opacity: 0; } }

  .strike { position: relative; width: fit-content; }
  .strike::after { content: ''; position: absolute; left: 0; right: 0; top: 55%; height: 1.5px; background: rgb(75 73 112 / .55); transform: scaleX(0); transform-origin: left; transition: transform .8s var(--ease-out-soft) .4s; }
  :global(.is-in) .strike::after, :global(html:not(.js)) .strike::after { transform: scaleX(1); }
  .ba-card { transition: transform .5s var(--ease-out-soft), box-shadow .5s; }
  .ba-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }

  .big-num { position: absolute; right: -2rem; top: 1rem; font: 600 clamp(12rem, 8rem + 16vw, 26rem)/1 var(--font-display); letter-spacing: -.06em; color: transparent; -webkit-text-stroke: 1.5px rgb(119 185 0 / .28); pointer-events: none; user-select: none; }

  .neighbors { background: linear-gradient(180deg, #fff 0%, var(--color-cloud) 30%, var(--color-sky) 100%); }
  .value-card { position: relative; overflow: hidden; padding: 1.4rem; border-radius: 1.25rem; background: rgb(255 255 255 / .8); box-shadow: inset 0 0 0 1px var(--color-line); transition: transform .5s var(--ease-out-soft), box-shadow .5s; }
  .value-card::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(220px circle at var(--mx, -100px) var(--my, -100px), rgb(119 185 0 / .16), transparent 70%); }
  .value-card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--color-lime), var(--shadow-lift); }
  .value-ico { display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: .9rem; background: var(--color-navy); color: var(--color-lime); transition: transform .5s var(--ease-out-soft); }
  .value-card:hover .value-ico { transform: rotate(-8deg) scale(1.06); }

  .town-pill { display: inline-flex; align-items: center; gap: .35rem; border-radius: 999px; padding: .45rem .9rem; font-size: .9rem; background: rgb(255 255 255 / .8); box-shadow: inset 0 0 0 1px var(--color-line); color: var(--color-ink); }
  .town-pill.is-pub { background: var(--color-navy); color: #fff; font-weight: 600; box-shadow: none; transition: background-color .3s, transform .4s var(--ease-out-soft); }
  .town-pill.is-pub:hover { background: var(--color-royal); transform: translateY(-2px); }
  @media (max-width: 1023.98px) { :global(.js) .towns:not(.is-open) .more-item { display: none; } }
  .more-btn { margin-top: .75rem; font-weight: 650; font-size: .92rem; color: var(--color-royal); text-decoration: underline; text-underline-offset: 4px; min-height: 2.75rem; }
  :global(html:not(.js)) .more-btn { display: none; }
  .map-frame :global(svg) { box-shadow: inset 0 0 0 1px var(--color-line), 0 30px 60px -30px rgb(21 14 117 / .35); }
</style>
