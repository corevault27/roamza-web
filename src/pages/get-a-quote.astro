---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HeroQuote from '../components/HeroQuote.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { img } from '../lib/images';
import { faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Get a Fast Quote', href: '/get-a-quote/' }];
const faqs = [
  { q: 'How long does it take to get a price?', a: 'Fast Quote shows your estimated cleaning price in under 15 seconds.' },
  { q: 'Is there a deposit?', a: `Yes. A $${business.deposit} deposit is required to secure your booking. It is paid through the secure booking checkout, which shows the available payment methods.` },
  { q: 'What happens after I request a quote?', a: 'You’ll see your estimate and can choose your date. Our team responds within 15 minutes, 7 days a week, to confirm details or answer questions.' },
  { q: 'Do all services have an instant price?', a: 'Regular, Signature Deep and Move-In / Move-Out cleaning can be estimated online. Office & commercial, post-construction and recurring Airbnb turnover service are priced after a walkthrough or property review.' },
  { q: 'Can I talk to a person instead?', a: `Of course. Call or text ${business.phone.display} or email ${business.email}.` },
];
---
<Base
  title="Get a Fast Cleaning Quote in 15 Seconds | Roamza"
  description="See your estimated cleaning price in under 15 seconds. House, deep, move-out and Airbnb cleaning in Dallas, PA and nearby. $50 deposit secures your date."
  image={img('real/open-kitchen-quartz-counter.jpg')}
  breadcrumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <section class="relative overflow-hidden pt-6 pb-20 lg:pb-28">
    <div class="absolute inset-0 glow-window pointer-events-none" aria-hidden="true"></div>
    <div class="container-x relative">
      <Breadcrumbs items={crumbs} />
      <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_31rem] lg:gap-16 items-start">
        <div class="lg:sticky lg:top-28">
          <p class="eyebrow hero-rise">Fast Quote · free · instant</p>
          <h1 class="mt-4 text-[clamp(2.2rem,1.5rem+2.6vw,3.8rem)] hero-rise">Get your cleaning price in 15 seconds</h1>
          <p class="lead mt-6 hero-rise" style="animation-delay:.12s">Tell us about your home and see an estimated price instantly. Choose a date and secure it with a ${business.deposit} deposit — no phone tag, no waiting for a callback.</p>
          <ul class="mt-8 grid gap-4">
            {[
              { i: 'bolt', t: 'Estimate in under 15 seconds' },
              { i: 'clock', t: 'We respond within 15 minutes, 7 days a week' },
              { i: 'shield', t: 'Licensed, bonded & insured · satisfaction guaranteed' },
              { i: 'user', t: 'Trained, background-checked team' },
            ].map((x) => <li class="flex items-center gap-3 text-[1.05rem]"><span class="grid place-items-center w-10 h-10 rounded-full bg-lime-100 text-lime-600 flex-none"><Icon name={x.i} size={20} /></span>{x.t}</li>)}
          </ul>
          <p class="mt-8 text-muted">Prefer to talk? <a href={business.phone.tel} class="link-u" data-track="call_click">Call</a>, <a href={business.phone.sms} class="link-u" data-track="sms_click">text</a> or <a href={business.whatsapp} class="link-u" target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp</a> {business.phone.display}.</p>
        </div>
        <div><h2 class="sr-only">Your instant cleaning estimate</h2><HeroQuote id="quote" /></div>
      </div>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-linen" aria-label="Frequently asked questions">
    <div class="container-x"><Faq faqs={faqs} heading="Quote & booking questions" /></div>
  </section>
</Base>
