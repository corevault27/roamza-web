---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
import { img } from '../lib/images';
import { abs } from '../lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact-us/' }];
const channels = [
  { icon: 'phone', label: 'Call', value: business.phone.display, href: business.phone.tel, track: 'call_click' },
  { icon: 'sms', label: 'Text', value: business.phone.display, href: business.phone.sms, track: 'sms_click' },
  { icon: 'mail', label: 'Email', value: business.email, href: `mailto:${business.email}`, track: 'email_click' },
];
---
<Base
  title="Contact Roamza Cleaning Services | Dallas, PA"
  description="Call, text or email Roamza Cleaning Services in Dallas, PA. We respond within 15 minutes, 7 days a week. Request your cleaning quote."
  image={img('team/roamza-team-uniforms.jpg')}
  breadcrumbs={crumbs}
  schema={[{ '@context': 'https://schema.org', '@type': 'ContactPage', url: abs('/contact-us/'), about: { '@id': abs('/#organization') } }]}
>
  <section class="relative overflow-hidden pt-6 pb-20 lg:pb-28">
    <div class="absolute inset-0 glow-window pointer-events-none" aria-hidden="true"></div>
    <div class="container-x relative">
      <Breadcrumbs items={crumbs} />
      <div class="mt-8 grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16 items-start">
        <div>
          <p class="eyebrow hero-rise">Contact</p>
          <h1 class="mt-4 text-[clamp(2.2rem,1.5rem+2.6vw,3.8rem)] hero-rise">Contact Roamza Cleaning Services</h1>
          <p class="lead mt-6 hero-rise" style="animation-delay:.12s">Tell us about your property and the service you need, and we’ll help you choose the best cleaning option — or see your price yourself with the live quote. Our response time promise is 15 minutes, and our teams are available 7 days a week.</p>
          <div class="mt-8 rounded-2xl bg-cloud p-6">
            <p class="font-semibold text-navy">Service area</p>
            <p class="text-muted mt-1">Based in {business.base.locality}, {business.base.region} {business.base.postalCode}. Proudly serving Luzerne, Lackawanna &amp; Wyoming Counties. <a href="/service-areas/" class="link-u">See all areas</a></p>
          </div>
        </div>

        <div>
          <h2 class="text-[clamp(1.6rem,1.3rem+1vw,2.1rem)]">Call, text or email</h2>
          <p class="text-muted mt-2">A real person answers — usually within 15 minutes, 7 days a week.</p>
          <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-4">
            {channels.map((c) => (
              <li><a href={c.href} class="card flex items-center gap-4 p-5 hover:shadow-[var(--shadow-lift)] transition-shadow" data-track={c.track}>
                <span class="grid place-items-center w-12 h-12 rounded-full bg-lime-100 text-lime-600 flex-none"><Icon name={c.icon} size={22} /></span>
                <span class="min-w-0"><span class="block text-sm text-muted">{c.label}</span><span class="block font-semibold text-navy break-words">{c.value}</span></span>
              </a></li>
            ))}
          </ul>
          <a href="/get-a-quote/" class="btn btn-primary btn-lg mt-8" data-track="quote_start">Get my live quote <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

