---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
---
<Base title="Thank You | Roamza Cleaning Services" description="Thanks for contacting Roamza Cleaning Services. Our team will respond within 15 minutes, 7 days a week." noindex>
  <section class="py-24 lg:py-36">
    <div class="container-x max-w-3xl text-center">
      <span class="inline-grid place-items-center w-16 h-16 rounded-full bg-lime text-navy"><Icon name="check" size={32} /></span>
      <h1 class="mt-6 text-[clamp(2.4rem,1.5rem+3.6vw,4.2rem)]">Thank you — we got your message</h1>
      <p class="lead mt-5">Our team responds within 15 minutes, 7 days a week. Need us sooner? Call or text <a href={business.phone.tel} class="link-u" data-track="call_click">{business.phone.display}</a>.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/get-a-quote/" class="btn btn-primary btn-lg" data-track="quote_start">See your price now <Icon name="arrow" size={18} /></a>
        <a href="/" class="btn btn-ghost btn-lg">Back to home</a>
      </div>
    </div>
  </section>
</Base>
