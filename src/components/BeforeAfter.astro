---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
interface Props { before?: string; after?: string; caption?: string }
const { before = 'proof/living-room-before.jpg', after = 'proof/living-room-after.jpg', caption = 'Same living room, before and after a Roamza cleaning.' } = Astro.props;
---
<figure class="ba" data-ba style="--pos:50%">
  <div class="ba-stage">
    <Image src={img(after)} alt="Living room after cleaning: clear floor, arranged cushions and tidy surfaces" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 60rem, 100vw" class="ba-img" loading="lazy" />
    <div class="ba-before" aria-hidden="true">
      <Image src={img(before)} alt="" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 60rem, 100vw" class="ba-img" loading="lazy" />
    </div>
    <span class="ba-tag left-4">Before</span>
    <span class="ba-tag ba-tag-after right-4">After</span>
    <div class="ba-handle" aria-hidden="true"><span></span></div>
    <label class="sr-only" for="ba-range">Drag to compare before and after</label>
    <input id="ba-range" type="range" min="0" max="100" value="50" step="1" class="ba-range" />
  </div>
  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>

<style>
  .ba-stage { position: relative; border-radius: 1.5rem; overflow: hidden; aspect-ratio: 16 / 9; box-shadow: var(--shadow-lift); background: var(--color-cloud); }
  .ba-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-before :global(img) { filter: saturate(.85); }
  .ba-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; translate: -50% 0; background: #fff; box-shadow: 0 0 0 1px rgb(21 14 117 / .15), 0 0 24px rgb(255 255 255 / .9); pointer-events: none; }
  .ba-handle span { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 3.25rem; height: 3.25rem; border-radius: 999px; background: #fff; box-shadow: var(--shadow-lift); }
  .ba-handle span::before, .ba-handle span::after { content: ''; position: absolute; top: 50%; width: .55rem; height: .55rem; border: solid var(--color-navy); border-width: 0 0 2.5px 2.5px; }
  .ba-handle span::before { left: .95rem; transform: translateY(-50%) rotate(45deg); }
  .ba-handle span::after { right: .95rem; transform: translateY(-50%) rotate(-135deg); }
  /* sheen sweeping over the "after" side */
  .ba-stage::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(110deg, transparent 40%, rgb(255 255 255 / .28) 50%, transparent 60%) no-repeat; background-size: 250% 100%; background-position: 150% 0; clip-path: inset(0 0 0 var(--pos)); animation: sheen 5s ease-in-out 1.5s infinite; }
  @keyframes sheen { 0%, 60% { background-position: 150% 0; } 100% { background-position: -100% 0; } }
  .ba-tag { position: absolute; top: 1rem; padding: .35rem .8rem; border-radius: 999px; background: rgb(14 10 79 / .78); color: #fff; font-size: .8rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; pointer-events: none; }
  .ba-tag-after { background: var(--color-lime); color: var(--color-navy); }
  .ba-range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }
  .ba-range:focus-visible + * , .ba-stage:has(.ba-range:focus-visible) { outline: 3px solid var(--color-royal); outline-offset: 4px; }
</style>
