---
/** Real Roamza job photos (client phone photos, EXIF/GPS stripped). */
import { Image } from 'astro:assets';
import { img, realAlt, realGallery } from '../lib/images';
interface Props { photos?: string[]; heading?: string; intro?: string; headingId?: string; chapter?: string }
const { photos = realGallery.slice(0, 8), heading = 'Real homes, really clean', intro = 'Every photo on this strip is from an actual Roamza job — no stock images.', headingId = 'gallery-heading', chapter } = Astro.props;
---
<section class="rg" aria-labelledby={headingId} data-hscroll>
  <div class="rg-stage py-20 lg:py-28" data-hscroll-stage>
  <div class="container-x flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div class="max-w-2xl">
      {chapter ? <p class="chapter" data-reveal><b>{chapter}</b><i></i>Real Roamza work</p> : <p class="eyebrow" data-reveal>Real Roamza work</p>}
      <h2 id={headingId} class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-words>{heading}</h2>
      <p class="lead mt-4" data-reveal style="--d:120">{intro}</p>
    </div>
    <p class="text-sm text-muted lg:hidden" aria-hidden="true">Swipe to see more →</p>
  </div>
  <ul class="gallery mt-10" tabindex="0" data-hscroll-track aria-label="Photos of real Roamza cleaning jobs">
    {photos.map((p, i) => (
      <li class="g-item" data-reveal style={`--d:${(i % 4) * 80}`}>
        <figure class="g-fig">
          <Image src={img(p)} alt={realAlt[p] ?? 'Real Roamza cleaning job'} widths={[360, 540, 720]} sizes="(min-width: 1024px) 22rem, 70vw" class="w-full h-full object-cover" loading="lazy" />
        </figure>
      </li>
    ))}
  </ul>
  </div>
</section>

<style>
  .rg { position: relative; overflow-x: clip; }
  /* desktop: the strip moves sideways as the page scrolls down (set up in fx.ts) */
  :global(.hs-on) > .rg-stage { position: sticky; top: 0; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; padding-block: 5.5rem 1.5rem; }
  :global(.hs-on) .gallery { overflow: visible; will-change: transform; margin-top: 2rem; }
  :global(.hs-on) .g-item { width: min(20rem, calc((100vh - 27rem) * .75)); }
  .gallery { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: .5rem max(1.25rem, calc((100vw - 78rem) / 2 + 2rem)) 1.5rem; scrollbar-width: thin; }
  .g-item { flex: none; width: min(22rem, 70vw); scroll-snap-align: center; }
  .g-item:nth-child(even) { margin-top: 2.5rem; }
  .g-item:nth-child(odd) .g-fig { rotate: -1.6deg; }
  .g-item:nth-child(even) .g-fig { rotate: 1.4deg; }
  .g-item:hover .g-fig { rotate: 0deg; }
  .g-fig { aspect-ratio: 3 / 4; border-radius: 1.25rem; overflow: hidden; border: 6px solid #fff; box-shadow: 0 2px 6px rgb(21 14 117 / .08), 0 26px 50px -22px rgb(21 14 117 / .4); transition: transform .6s var(--ease-out-soft), box-shadow .6s var(--ease-out-soft), rotate .6s var(--ease-out-soft); }
  .g-fig :global(img) { transition: transform 1.2s var(--ease-out-soft); }
  .g-item:hover .g-fig { transform: translateY(-8px); box-shadow: var(--shadow-lift); }
  .g-item:hover .g-fig :global(img) { transform: scale(1.05); }
</style>
