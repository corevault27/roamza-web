---
import Icon from './Icon.astro';
interface Props { heading?: string }
const { heading = 'Getting started is simple' } = Astro.props;
const steps = [
  { icon: 'bolt', title: 'Get your instant quote', text: 'Answer a few questions about your home and see an estimated price in under 15 seconds.' },
  { icon: 'calendar', title: 'Choose your schedule', text: 'Pick a date and frequency — weekly, bi-weekly, every 3 weeks or monthly. A $50 deposit secures it.' },
  { icon: 'home', title: 'Enjoy a clean home', text: 'Our background-checked team arrives on time and cleans to the same standard every visit.' },
];
---
<section class="py-20 lg:py-28" aria-labelledby="process-heading">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>How it works</p>
      <h2 id="process-heading" class="mt-4 text-[clamp(2.1rem,1.4rem+2.6vw,3.6rem)]" data-reveal style="--d:60">{heading}</h2>
    </div>
    <div class="relative mt-14" data-draw-host>
      <svg class="hidden md:block absolute left-0 right-0 top-[2.1rem] w-full h-6 overflow-visible" viewBox="0 0 1000 20" preserveAspectRatio="none" aria-hidden="true">
        <path d="M30 10 H970" stroke="var(--color-line)" stroke-width="2" fill="none" vector-effect="non-scaling-stroke" />
        <path d="M30 10 H970" stroke="var(--color-lime)" stroke-width="3" fill="none" stroke-linecap="round" vector-effect="non-scaling-stroke" data-draw />
      </svg>
      <ol class="grid gap-10 md:grid-cols-3 md:gap-8 relative">
        {steps.map((s, i) => (
          <li class="proc-step" data-step-at={(i / 3 + 0.05).toFixed(2)} data-reveal style={`--d:${i * 120}`}>
            <span class="proc-dot"><Icon name={s.icon} size={26} /></span>
            <p class="mt-6 text-sm font-semibold tracking-[.14em] uppercase text-royal">Step {i + 1}</p>
            <h3 class="text-2xl mt-2">{s.title}</h3>
            <p class="text-muted mt-3 max-w-xs">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .proc-dot { display: grid; place-items: center; width: 4.25rem; height: 4.25rem; border-radius: 999px; background: #fff; color: var(--color-navy); box-shadow: inset 0 0 0 2px var(--color-line), var(--shadow-soft); transition: background-color .5s, color .5s, box-shadow .5s, transform .6s var(--ease-out-soft); position: relative; }
  .proc-step:global(.is-lit) .proc-dot { background: var(--color-lime); color: var(--color-navy); box-shadow: 0 0 0 8px var(--color-lime-100), var(--shadow-soft); transform: scale(1.04); }
  :global(html:not(.js)) .proc-dot { background: var(--color-lime); }
</style>
