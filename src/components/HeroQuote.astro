---
/**
 * Hero quote: the official FastQuoted widget, alone, sitting directly on the
 * hero (no frame, no photo behind it) — like the original site.
 * - The iframe is in the HTML from the start (loads in parallel with the page);
 *   preconnect hints live in Base.astro. The bridge script is injected right
 *   after first paint so it never blocks rendering.
 * - Without JS the iframe still works; a plain link is offered as fallback.
 */
import { business } from '../data/business';
const fq = business.fastQuote;
---
<div id="hero-quote" class="hq" data-fastquote="eager" data-bridge={fq.bridge}>
  <div id="fastquoted-root"></div>
  <iframe data-fastquoted-widget="true" src={fq.src} title="Roamza instant cleaning quote" width="100%" height="640" loading="eager" style="border:0;background:transparent;display:block" allowtransparency="true" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <noscript><p class="mt-3 text-sm"><a href={fq.src} target="_blank" rel="noopener" class="link-u">Open the quote calculator</a></p></noscript>
</div>

<style>
  .hq { position: relative; z-index: 2; width: min(100%, 31rem); margin-inline: auto; scroll-margin-top: 6rem; }
  .hq :global(iframe) { min-height: 640px; }
  @media (min-width: 1024px) { .hq { margin-right: 0; } }
</style>
