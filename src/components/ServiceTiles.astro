---
/**
 * Visual service tiles: photo/illustration + animated icon + one line.
 * Desktop: bento grid (2 feature tiles + 4). Mobile: swipeable snap carousel
 * (less vertical text). Full service descriptions stay in each service page.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import AnimatedIcon from './AnimatedIcon.astro';
import { services } from '../data/services';
import { img } from '../lib/images';
const iconFor: Record<string, string> = {
  'regular-cleaning': 'regular', 'deep-cleaning': 'deep', 'move-out-in-cleaning': 'move',
  'airbnb-cleaning': 'airbnb', 'office-cleaning': 'office', 'construction-cleaning': 'construction',
};
const photoFor: Record<string, string> = {
  'regular-cleaning': 'real/living-room-white-sofa.jpg',
  'deep-cleaning': 'real/open-kitchen-quartz-counter.jpg',
  'move-out-in-cleaning': 'real/hardwood-room-blue-walls.jpg',
  'airbnb-cleaning': 'real/bedroom-guest-ready.jpg',
  'office-cleaning': 'rooms/office-open-plan.jpg',
  'construction-cleaning': 'rooms/post-construction.jpg',
};
const tags: Record<string, string> = {
  'regular-cleaning': 'Weekly · Bi-weekly · Monthly', 'deep-cleaning': 'Top-to-bottom reset', 'move-out-in-cleaning': 'Empty homes',
  'airbnb-cleaning': 'For hosts', 'office-cleaning': 'Custom plans', 'construction-cleaning': 'After the build',
};
---
<ul class="tiles" aria-label="Roamza cleaning services">
  {services.map((s, i) => (
    <li class:list={['tile-li', i < 2 && 'is-feature']} data-reveal style={`--d:${i * 70}`}>
      <a href={`/${s.slug}/`} class="tile ai-host">
        <Image src={img(photoFor[s.slug])} alt="" widths={[360, 560, 820]} sizes={i < 2 ? '(min-width: 1024px) 38rem, 82vw' : '(min-width: 1024px) 25rem, 82vw'} class="tile-img" loading="lazy" />
        <span class="tile-shade" aria-hidden="true"></span>
        <span class="tile-top">
          <span class="tile-ico"><AnimatedIcon name={iconFor[s.slug]} size={30} /></span>
          <span class="tile-tag">{tags[s.slug]}</span>
        </span>
        <span class="tile-body">
          <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="tile-name">{s.name}</span>
          <span class="tile-short">{s.short}</span>
          <span class="tile-go">Explore <Icon name="arrow" size={16} /></span>
        </span>
      </a>
    </li>
  ))}
</ul>
<p class="tiles-hint lg:hidden" aria-hidden="true">Swipe to see all six →</p>

<style>
  .tiles { display: grid; gap: 1.1rem; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .tile-li { grid-column: span 2; }
  .tile-li.is-feature { grid-column: span 3; }
  .tile { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: space-between; min-height: 24rem; height: 100%; padding: 1.4rem; border-radius: 1.6rem; overflow: hidden; color: #fff; text-decoration: none; box-shadow: 0 2px 6px rgb(21 14 117 / .08), 0 30px 60px -30px rgb(21 14 117 / .55); transform: translateZ(0); }
  .is-feature .tile { min-height: 30rem; }
  .tile :global(.tile-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease-out-soft); }
  .tile-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(14 10 79 / .15) 0%, rgb(14 10 79 / .1) 35%, rgb(14 10 79 / .88) 100%); transition: background .5s; }
  .tile-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .tile-ico { display: grid; place-items: center; width: 3.6rem; height: 3.6rem; border-radius: 1.1rem; background: var(--color-lime); color: var(--color-navy); box-shadow: 0 10px 24px -10px rgb(0 0 0 / .45); transition: transform .5s var(--ease-out-soft), border-radius .5s; }
  .tile-tag { padding: .4rem .75rem; border-radius: 999px; background: rgb(14 10 79 / .55); backdrop-filter: blur(6px); font-size: .78rem; font-weight: 650; letter-spacing: .02em; }
  .tile-body { display: grid; gap: .35rem; }
  .tile-num { font: 500 .85rem/1 var(--font-display); color: var(--color-lime); letter-spacing: .05em; }
  .tile-name { font: 600 clamp(1.45rem, 1.1rem + 1vw, 2rem)/1.08 var(--font-display); letter-spacing: -.015em; }
  .tile-short { color: rgb(255 255 255 / .86); font-size: .96rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tile-go { display: inline-flex; align-items: center; gap: .4rem; margin-top: .5rem; font-weight: 650; font-size: .92rem; color: var(--color-lime); }
  .tile-go :global(svg) { transition: transform .45s var(--ease-out-soft); }
  .tile:hover :global(.tile-img), .tile:focus-visible :global(.tile-img) { transform: scale(1.07); }
  .tile:hover .tile-shade { background: linear-gradient(180deg, rgb(14 10 79 / .05) 0%, rgb(14 10 79 / .05) 30%, rgb(14 10 79 / .92) 100%); }
  .tile:hover .tile-ico { transform: rotate(-6deg) scale(1.06); border-radius: 50%; }
  .tile:hover .tile-go :global(svg) { transform: translateX(4px); }
  .tile:focus-visible { outline: 3px solid var(--color-lime); outline-offset: 4px; }
  .tiles-hint { margin-top: .9rem; font-size: .85rem; color: var(--color-muted); }
  @media (max-width: 1023.98px) {
    .tiles { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: .9rem; margin-inline: -1.25rem; padding: .25rem 1.25rem 1rem; scrollbar-width: none; }
    .tiles::-webkit-scrollbar { display: none; }
    .tile-li, .tile-li.is-feature { flex: none; width: 82%; scroll-snap-align: center; }
    .tile, .is-feature .tile { min-height: 25rem; }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) { .tile-li, .tile-li.is-feature { width: 46%; } }
</style>
