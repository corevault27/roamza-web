---
/**
 * Roamza animated line icons (own set, no third-party player).
 * Strokes draw in when the icon enters the viewport and redraw on hover of
 * the closest `.ai-host`. Static and fully drawn without JS or with reduced motion.
 * Swap-ready: if Lordicon (or similar) is licensed later, replace this component only.
 */
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 32, class: cls = '', label } = Astro.props;
const icons: Record<string, string[]> = {
  regular: ['M4 11.5 12 4.5l8 7', 'M6.5 9.8V19.5h11V9.8', 'M14.6 14.6a2.6 2.6 0 1 1-1-2.1', 'M13.9 10.9l-.3 1.9 1.9.2'],
  deep: ['M9 8.5h5.2l1.3 3.2V20a1 1 0 0 1-1 1H8.8a1 1 0 0 1-1-1v-8.3z', 'M10.2 8.5V5.2h4', 'M14.2 5.2h2.6l1 1.8', 'M19.5 3.5v1.4', 'M21 6.2h-1.4', 'M20.7 8.6l-1-1'],
  move: ['M3.5 8.2 12 4l8.5 4.2v7.9L12 20.3l-8.5-4.2z', 'M3.5 8.2 12 12.4l8.5-4.2', 'M12 12.4v7.9', 'M7.8 6.1l8.4 4.2'],
  airbnb: ['M3 19V7.5', 'M3 14.5h18V19', 'M21 14.5v-2.2a3 3 0 0 0-3-3h-6.5v5.2', 'M7.3 10.2a1.7 1.7 0 1 0 0 .01'],
  office: ['M4 21V5.2L12 3v18', 'M12 9h8v12', 'M2.5 21h19', 'M7.5 8.2h1.2', 'M7.5 12h1.2', 'M7.5 15.8h1.2', 'M15.5 13h1.2', 'M15.5 16.8h1.2'],
  construction: ['M3 17.5h18', 'M5 17.5a7 7 0 0 1 14 0', 'M10 11V7.5h4V11', 'M4.5 20.5h15'],
  clock: ['M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18', 'M12 7.5V12l3 2'],
  shield: ['M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z', 'm9 12.2 2.1 2.1 4-4.2'],
  user: ['M12 4a4 4 0 1 1 0 8 4 4 0 0 1 0-8', 'M4 21a8 8 0 0 1 16 0'],
  chat: ['M21 12a8 8 0 0 1-11.6 7.1L4 20l1.2-4.6A8 8 0 1 1 21 12z', 'M8.5 12h.01', 'M12 12h.01', 'M15.5 12h.01'],
  bolt: ['M13 3 5 13.5h6L10 21l8-10.5h-6z'],
  calendar: ['M5.5 5h13a2 2 0 0 1 2 2v11.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2', 'M3.5 10h17', 'M8 3v4', 'M16 3v4', 'm9 15 2 2 4-4'],
  home: ['M3 11.5 12 4l9 7.5', 'M5.5 10v10h13V10', 'M10 20v-5h4v5'],
  pin: ['M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z', 'M12 7a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5'],
  heart: ['M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z'],
};
const paths = icons[name] ?? icons.home;
---
<svg
  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="none"
  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
  class:list={['ai', cls]} data-ai aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false"
>
  {paths.map((d, i) => <path d={d} pathLength="1" style={`--k:${i}`} />)}
</svg>
