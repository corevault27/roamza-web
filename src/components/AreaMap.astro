---
/**
 * Schematic service-area map. Towns are placed from real (approximate)
 * coordinates; rings show distance from our Dallas, PA base. Accessible
 * equivalent: the city lists rendered next to / below the map.
 */
import { cities, counties, cityUrl } from '../data/areas';
import { business } from '../data/business';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const W = 600, H = 740, LNG0 = -76.1, LAT0 = 41.585, K = 1600, COS = 0.751;
const px = (lng: number) => (lng - LNG0) * COS * K;
const py = (lat: number) => (LAT0 - lat) * K;
const base = { x: px(business.geo.lng), y: py(business.geo.lat) };
const mile = K / 69; // px per mile (latitude)
const rings = [10, 20, 30];
const labeled = new Set(['tunkhannock-pa', 'harveys-lake-pa', 'clarks-summit-pa', 'nanticoke-pa', 'pittston-pa', 'dunmore-pa']);
const pts = cities.map((c) => ({ ...c, x: px(c.lng), y: py(c.lat) }));
const published = pts.filter((c) => c.status === 'published');
const anchorRight = new Set(['kingston-pa', 'dallas-pa', 'nanticoke-pa', 'harveys-lake-pa', 'tunkhannock-pa', 'shavertown-pa']);
---
<div class:list={['area-map relative', compact ? '' : 'lg:sticky lg:top-28']} data-map>
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto rounded-[1.75rem] bg-cloud" role="group" aria-labelledby="map-title" aria-describedby="map-desc" data-draw-host>
    <title id="map-title">Roamza service area map</title>
    <desc id="map-desc">Schematic map of Luzerne, Lackawanna and Wyoming Counties in Pennsylvania showing the towns Roamza serves, with rings at 10, 20 and 30 miles from our base in Dallas, PA.</desc>
    <defs>
      <radialGradient id="mapglow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#eef7dc" /><stop offset="1" stop-color="#eef7dc" stop-opacity="0" /></radialGradient>
    </defs>
    <circle cx={base.x} cy={base.y} r={mile * 12} fill="url(#mapglow)" />
    {rings.map((r) => (
      <g>
        <circle cx={base.x} cy={base.y} r={r * mile} fill="none" stroke="#c9c5e3" stroke-width="1.2" stroke-dasharray="3 6" />
        <text x={base.x + r * mile * 0.71 + 4} y={base.y - r * mile * 0.71 - 4} class="ring-label">{r} mi</text>
      </g>
    ))}
    <text x="40" y="60" class="county-label">Wyoming Co.</text>
    <text x={W - 40} y="140" text-anchor="end" class="county-label">Lackawanna Co.</text>
    <text x="40" y={H - 40} class="county-label">Luzerne Co.</text>

    {published.filter((c) => c.slug !== 'dallas-pa').map((c) => (
      <path d={`M${base.x} ${base.y} Q ${(base.x + c.x) / 2} ${Math.min(base.y, c.y) - 40} ${c.x} ${c.y}`} fill="none" stroke="var(--color-lime)" stroke-width="2.2" stroke-linecap="round" data-draw />
    ))}

    {pts.filter((c) => c.status === 'draft').map((c) => (
      <g class="city draft" data-city={c.slug} data-name={c.name} data-county={counties[c.county].name}>
        <circle cx={c.x} cy={c.y} r="5" />
        {labeled.has(c.slug) && <text x={c.x + (anchorRight.has(c.slug) ? -10 : 10)} y={c.y + 4} text-anchor={anchorRight.has(c.slug) ? 'end' : 'start'} class="city-label small">{c.name}</text>}
      </g>
    ))}

    {published.map((c) => (
      <a href={cityUrl(c)} class="city pub" data-city={c.slug} data-name={c.name} data-county={counties[c.county].name} data-href={cityUrl(c)} aria-label={`${c.name}, PA — local cleaning page`}>
        <circle cx={c.x} cy={c.y} r="16" class="pulse" />
        <path d={`M${c.x - 11} ${c.y + 3} L${c.x} ${c.y - 8} L${c.x + 11} ${c.y + 3}`} class="roof" />
        <rect x={c.x - 7} y={c.y + 1} width="14" height="9" rx="1.5" class="house" />
        <text x={c.x + (anchorRight.has(c.slug) ? -18 : 18)} y={c.y + 5} text-anchor={anchorRight.has(c.slug) ? 'end' : 'start'} class="city-label">{c.name}</text>
      </a>
    ))}
    <g class="base" transform={`translate(${base.x} ${base.y})`}>
      <circle r="9" fill="var(--color-navy)" />
    </g>
  </svg>

  <div class="map-panel card" data-map-panel aria-live="polite">
    <p class="text-xs font-semibold tracking-[.14em] uppercase text-royal" data-p-county>Luzerne County</p>
    <p class="font-display text-2xl text-navy mt-1" data-p-name>Dallas, PA</p>
    <p class="text-sm text-muted mt-1" data-p-note>Our home base</p>
    <a href="/service-areas/dallas-pa/" class="link-u text-sm mt-2 inline-block" data-p-link>View local page →</a>
  </div>
</div>

<style>
  .area-map svg { box-shadow: inset 0 0 0 1px var(--color-line); }
  .ring-label { font: 600 12px var(--font-sans); fill: #8d89b3; }
  .county-label { font: 600 13px var(--font-sans); letter-spacing: .14em; text-transform: uppercase; fill: #9a97bd; }
  .city-label { font: 650 15px var(--font-sans); fill: var(--color-navy); paint-order: stroke; stroke: var(--color-cloud); stroke-width: 5px; stroke-linejoin: round; }
  .city-label.small { font-size: 12.5px; font-weight: 600; fill: var(--color-muted); }
  .draft circle { fill: #fff; stroke: var(--color-navy); stroke-width: 2; transition: r .3s, fill .3s; }
  .draft:hover circle, .draft:global(.is-active) circle { fill: var(--color-lime); r: 8; }
  .pub .roof { fill: none; stroke: var(--color-navy); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .pub .house { fill: var(--color-lime); }
  .pub .pulse { fill: var(--color-lime); opacity: .22; transform-box: fill-box; transform-origin: center; animation: pulse 2.6s ease-out infinite; }
  .pub:hover .roof, .pub:focus-visible .roof, .pub:global(.is-active) .roof { stroke: var(--color-royal); }
  .pub:focus-visible { outline: none; }
  .pub:focus-visible .pulse { opacity: .6; }
  @keyframes pulse { 0% { transform: scale(.6); opacity: .45; } 100% { transform: scale(1.6); opacity: 0; } }
  .map-panel { position: absolute; left: 1rem; bottom: 1rem; padding: 1rem 1.2rem; min-width: 13rem; }
  @media (max-width: 480px) { .map-panel { position: static; margin-top: .75rem; } }
</style>
