---
/**
 * Story progress guide.
 * Desktop (≥1440px): fixed vertical rail with chapter numbers; hover/focus shows the label.
 * Everywhere: thin top progress bar that fills with page scroll.
 * Pure navigation links → works without JS (anchors); JS only adds active state.
 */
interface Props { chapters: { id: string; label: string }[] }
const { chapters } = Astro.props;
---
<div class="page-progress" aria-hidden="true"><span data-page-progress></span></div>
<nav class="chapter-rail" aria-label="Page sections" data-chapter-rail>
  <ol>
    {chapters.map((c, i) => (
      <li>
        <a href={`#${c.id}`} data-chapter-link={c.id}>
          <span class="cr-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="cr-label">{c.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .page-progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 70; pointer-events: none; }
  .page-progress span { display: block; height: 100%; background: linear-gradient(90deg, var(--color-lime), #a6d94a); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .chapter-rail { display: none; }
  @media (min-width: 1440px) {
    .chapter-rail { display: block; position: fixed; left: 1.25rem; top: 50%; translate: 0 -50%; z-index: 30; }
    .chapter-rail ol { display: grid; gap: .35rem; position: relative; padding-left: .25rem; }
    .chapter-rail ol::before { content: ''; position: absolute; left: 1.05rem; top: .6rem; bottom: .6rem; width: 1px; background: rgb(21 14 117 / .14); }
    .chapter-rail a { position: relative; display: flex; align-items: center; gap: .6rem; padding: .2rem; text-decoration: none; color: var(--color-muted); border-radius: 999px; }
    .cr-num { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 999px; font: 650 .66rem/1 var(--font-sans); letter-spacing: .02em; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); transition: background-color .35s, color .35s, box-shadow .35s, transform .45s var(--ease-out-soft); position: relative; z-index: 1; }
    .cr-label { font: 600 .82rem/1 var(--font-sans); white-space: nowrap; color: var(--color-navy); background: #fff; padding: .45rem .7rem; border-radius: 999px; box-shadow: var(--shadow-soft); opacity: 0; translate: -6px 0; transition: opacity .3s, translate .4s var(--ease-out-soft); pointer-events: none; }
    .chapter-rail a:hover .cr-label, .chapter-rail a:focus-visible .cr-label, .chapter-rail a.is-active .cr-label { opacity: 1; translate: 0 0; }
    .chapter-rail a:hover .cr-num { box-shadow: inset 0 0 0 1.5px var(--color-navy); color: var(--color-navy); }
    .chapter-rail a.is-active .cr-num { background: var(--color-lime); color: var(--color-navy); box-shadow: 0 0 0 5px rgb(119 185 0 / .18); transform: scale(1.12); }
    :global(html:not(.js)) .chapter-rail a .cr-label { opacity: 0; }
  }
  @media (min-width: 1440px) and (max-width: 1679.98px) {
    .chapter-rail a:not(:hover):not(:focus-visible) .cr-label { opacity: 0; }
  }
</style>
