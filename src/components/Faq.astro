---
import type { Faq } from '../data/services';
interface Props { faqs: Faq[]; heading?: string; intro?: string; headingLevel?: 'h2' | 'h3' }
const { faqs, heading = 'Frequently asked questions', intro, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const QH = headingLevel === 'h2' ? 'h3' : 'h4';
---
<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
  <div>
    <H class="text-[clamp(2rem,1.4rem+2vw,3rem)]" data-reveal>{heading}</H>
    {intro && <p class="lead mt-4" data-reveal style="--d:80">{intro}</p>}
    <p class="mt-6 text-muted" data-reveal style="--d:120">Still have a question? <a href="/contact-us/" class="link-u">Contact us</a> or call <a href="tel:+12722033263" class="link-u" data-track="call_click">(272) 203-3263</a>.</p>
  </div>
  <div class="border-t border-line">
    {faqs.map((f, i) => (
      <details class="faq group border-b border-line" data-faq data-reveal style={`--d:${i * 50}`}>
        <summary class="flex items-start justify-between gap-6 py-5 cursor-pointer list-none">
          <QH class="font-sans text-[1.08rem] font-semibold text-navy leading-snug tracking-normal">{f.q}</QH>
          <span class="faq-icon" aria-hidden="true"></span>
        </summary>
        <div data-faq-body class="overflow-hidden">
          <p class="pb-6 pr-10 text-muted">{f.a}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  summary::-webkit-details-marker { display: none; }
  summary:hover :is(h3, h4) { color: var(--color-royal); }
  .faq-icon { position: relative; flex: none; width: 2rem; height: 2rem; border-radius: 999px; background: var(--color-cloud); transition: background-color .3s, transform .45s var(--ease-out-soft); margin-top: -.15rem; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: .8rem; height: 2px; background: var(--color-navy); border-radius: 2px; translate: -50% -50%; transition: transform .45s var(--ease-out-soft); }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon { background: var(--color-lime); transform: rotate(45deg); }
</style>
