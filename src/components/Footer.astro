---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business } from '../data/business';
import { services } from '../data/services';
import { publishedCities, counties, cityUrl } from '../data/areas';
import { img } from '../lib/images';
const year = new Date().getFullYear();
const socials = [
  { name: 'facebook', href: business.social.facebook, label: 'Facebook' },
  { name: 'instagram', href: business.social.instagram, label: 'Instagram' },
  { name: 'tiktok', href: business.social.tiktok, label: 'TikTok' },
  { name: 'google', href: business.social.google, label: 'Google Business Profile' },
];
---
<footer class="on-dark bg-navy-900 text-white relative overflow-hidden border-t border-white/10">
  <div class="absolute inset-0 pointer-events-none opacity-60" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-[38rem] h-[38rem] rounded-full bg-royal/25 blur-3xl"></div>
  </div>
  <div class="container-x relative pt-16 pb-10">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <Image src={img('brand/roamza-logo-white-horizontal.png')} alt={business.name} width={200} height={51} class="h-11 w-auto" />
        <p class="mt-5 max-w-sm text-white/75">Locally owned home and office cleaning based in Dallas, PA — proudly serving Luzerne, Lackawanna & Wyoming Counties.</p>
        <address class="not-italic mt-6 grid gap-2 text-white/90">
          <span class="font-semibold">{business.legalName}</span>
          <span>{business.base.locality}, {business.base.regionName} {business.base.postalCode}</span>
          <a href={business.phone.tel} class="inline-flex items-center gap-2 hover:text-lime" data-track="call_click"><Icon name="phone" size={18} /> {business.phone.display}</a>
          <a href={`mailto:${business.email}`} class="inline-flex items-center gap-2 hover:text-lime" data-track="email_click"><Icon name="mail" size={18} /> {business.email}</a>
        </address>
        <ul class="flex gap-2 mt-6" aria-label="Social profiles">
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="flex w-11 h-11 items-center justify-center rounded-full bg-white/10 hover:bg-lime hover:text-navy transition-colors" aria-label={`${business.name} on ${s.label}`}><Icon name={s.name} size={20} /></a></li>
          ))}
        </ul>
      </div>
      <nav aria-label="Services">
        <h2 class="text-lg font-sans font-semibold text-white mb-4">Services</h2>
        <ul class="grid gap-2.5 text-white/75">
          {services.map((s) => <li><a href={`/${s.slug}/`} class="hover:text-lime">{s.navLabel}</a></li>)}
          <li><a href="/get-a-quote/" class="hover:text-lime">Get my live quote</a></li>
        </ul>
      </nav>
      <nav aria-label="Service areas">
        <h2 class="text-lg font-sans font-semibold text-white mb-4">Service Areas</h2>
        <ul class="grid gap-2.5 text-white/75">
          {Object.entries(counties).map(([slug, c]) => <li><a href={`/service-areas/${slug}/`} class="hover:text-lime">{c.name}</a></li>)}
          {publishedCities.map((c) => <li><a href={cityUrl(c)} class="hover:text-lime">{c.name}, PA</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2 class="text-lg font-sans font-semibold text-white mb-4">Company</h2>
        <ul class="grid gap-2.5 text-white/75">
          <li><a href="/about/" class="hover:text-lime">About Roamza</a></li>
          <li><a href="/resources/" class="hover:text-lime">Cleaning Resources</a></li>
          <li><a href="/faq/" class="hover:text-lime">FAQ</a></li>
          <li><a href="/contact-us/" class="hover:text-lime">Contact</a></li>
          <li><a href="/roamza-cleaning-services-partners-with-cleaning-for-a-reason-to-support-cancer-patients/" class="hover:text-lime">Cleaning for a Reason</a></li>
        </ul>
        <p class="mt-6 text-sm text-white/60">Response time: 15 minutes<br />Available 7 days a week</p>
      </nav>
    </div>
    <div class="mt-14 pt-6 border-t border-white/15 flex flex-col md:flex-row gap-3 md:items-center md:justify-between text-sm text-white/60">
      <p>© {year} {business.legalName}. Licensed, bonded & insured.</p>
      <p class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
        <a href="/terms-conditions/" class="hover:text-white">Terms & Conditions</a>
        <a href={business.agency.url} target="_blank" rel="noopener" class="hover:text-white">Marketing by {business.agency.name}</a>
      </p>
    </div>
  </div>
</footer>
